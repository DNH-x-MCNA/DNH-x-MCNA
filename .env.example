# Mẫu cấu hình môi trường (.env)

# Cấu hình AI Chatbot (ai_agent/chatbot.py) — thứ tự ưu tiên: Claude > Gemini > OpenAI > Mock
# Chỉ cần điền 1 trong 3 key dưới đây để bật chế độ Live.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cấu hình tài khoản gửi Email (Outlook SMTP)
SMTP_USER=user@outlook.com
SMTP_PASSWORD=YourAppPasswordOrPasswordHere
SENDER_EMAIL=user@outlook.com
RECIPIENT_EMAILS=recipient@example.com,another@example.com

# Cấu hình kết nối SQL Server (Chỉ dùng khi environment = production)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASS=YourStrongDbPassword
ERP_DB_NAME=ERP_Prod
CRM_DB_NAME=CRM_Prod

# Kết nối Supabase Postgres production (nguồn thật cho chatbot/alert/dashboard)
CLOUD_DB_URL=postgresql://user:password@host:5432/postgres

# (Tùy chọn) Supabase project riêng cho dev/test — dùng với scripts/clone_to_dev_supabase.py
# để lấy 1 bản sao dữ liệu production, không đụng vào dữ liệu thật khi phát triển/thử nghiệm.
DEV_CLOUD_DB_URL=

# Kết nối SQL Server thật của DNH (chỉ đọc) — dùng bởi scripts/sync_from_bravo_to_supabase.py
BRAVO_SQL_SERVER=172.16.0.26
BRAVO_SQL_DATABASE=NH_Report_TM
BRAVO_SQL_UID=rep
BRAVO_SQL_PWD=

# Địa chỉ web chatbot — dùng để dựng nút "Xem chi tiết trên Chatbot"/"Hỏi Chatbot DNH" trong card
# Teams và "Mở Chatbot DNH" trong báo cáo Weekly/Monthly (src/notifier.py::_chatbot_deep_link,
# NGUỒN DUY NHẤT cho cả 3 nút — đổi biến này là đổi được cả 3, không cần sửa code).
# 13/07/2026: chatbot do người khác phụ trách, deploy trên Vercel — không còn tự host
# backend/main.py trong repo này qua Cloudflare Tunnel/máy 24 (approach cũ, xem git log nếu cần
# quay lại self-host).
CHATBOT_WEB_URL=https://dnh-bot.vercel.app

# CHATBOT_USERS_JSON: tài khoản đăng nhập web chatbot (backend/main.py) — JSON object
# {"username": "password"}. BẮT BUỘC phải set (backend fail-fast nếu thiếu) — KHÔNG hardcode mật
# khẩu thật trong bất kỳ file .py nào, chỉ đặt trong .env (đã gitignore, không commit).
CHATBOT_USERS_JSON={"admin":"doi-mat-khau-nay","c_level":"doi-mat-khau-nay"}
