# Mẫu cấu hình môi trường (.env)

# Cấu hình AI Chatbot (ai_agent/chatbot.py) — thứ tự ưu tiên: Claude > Gemini > OpenAI > Mock
# Chỉ cần điền 1 trong 3 key dưới đây để bật chế độ Live.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cấu hình tài khoản gửi Email (Outlook SMTP)
SMTP_USER=bao-cao@ten-mien-dnh.vn
SMTP_PASSWORD=YourAppPasswordOrPasswordHere
SENDER_EMAIL=bao-cao@ten-mien-dnh.vn
RECIPIENT_EMAILS=recipient@example.com,another@example.com

# Cấu hình kết nối SQL Server (Chỉ dùng khi environment = production)
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASS=YourStrongDbPassword
ERP_DB_NAME=ERP_Prod
CRM_DB_NAME=CRM_Prod

# Kết nối Supabase Postgres production (nguồn thật cho chatbot/alert/dashboard)
CLOUD_DB_URL=postgresql://user:password@host:5432/postgres

# (Tùy chọn) Supabase project riêng cho dev/test — dùng với scripts/clone_to_dev_supabase.py
# để lấy 1 bản sao dữ liệu production, không đụng vào dữ liệu thật khi phát triển/thử nghiệm.
DEV_CLOUD_DB_URL=

# Kết nối SQL Server thật của DNH (chỉ đọc) — dùng bởi scripts/sync_from_bravo_to_supabase.py
BRAVO_SQL_SERVER=<IP_MAY_CHU_BRAVO>
BRAVO_SQL_DATABASE=<TEN_CSDL_BRAVO>
BRAVO_SQL_UID=<TAI_KHOAN_CHI_DOC>
BRAVO_SQL_PWD=

# Địa chỉ web chatbot — dùng để dựng nút "Xem chi tiết trên Chatbot"/"Hỏi Chatbot DNH" trong card
# Teams và "Mở Chatbot DNH" trong báo cáo Weekly/Monthly (src/notifier.py::_chatbot_deep_link,
# NGUỒN DUY NHẤT cho cả 3 nút — đổi biến này là đổi được cả 3, không cần sửa code).
# 13/07/2026: chatbot do người khác phụ trách, deploy trên Vercel — không còn tự host
# backend/main.py trong repo này qua Cloudflare Tunnel/máy 24 (approach cũ, xem git log nếu cần
# quay lại self-host).
CHATBOT_WEB_URL=https://dnh-bot.vercel.app

# Webhook Teams cho 6 audience trong config/config.yaml (28/09/2026: KHONG ghi URL trong git nua - repo tung
# public va lo URL). config.yaml ghi "${TEN_BIEN}", gia tri that dat o day. Chuyen tu ban cu:
# python scripts/chuyen_webhook_sang_env.py. backend/health_watchdog.py dung TEAMS_WEBHOOK_C_LEVEL
# (hoac WATCHDOG_TEAMS_WEBHOOK neu muon kenh rieng).
TEAMS_WEBHOOK_C_LEVEL=
TEAMS_WEBHOOK_MIEN_BAC=
TEAMS_WEBHOOK_MIEN_NAM=
TEAMS_WEBHOOK_MIEN_TRUNG=
TEAMS_WEBHOOK_KENH_OTC=
TEAMS_WEBHOOK_KENH_ETC=
# WATCHDOG_TEAMS_WEBHOOK=

# MOT Flow dung chung cho ca 6 audience (thay cho 6 Flow rieng) - dat TEAMS_DELIVERY_MODE=shared. Flow trong
# make.powerautomate.com: trigger "When a Teams webhook request is received" (Who can trigger: Anyone) -> "Post card
# in a chat or channel" (Post as Flow bot, Post in Chat with Flow bot, Recipient = bieu thuc triggerBody()?['recipient']).
# TEAMS_RECIPIENTS_FILE tro toi JSON {"<ten audience dung nhu config.yaml>": "upn@ten-mien"}, moi audience MOT nguoi,
# chep tu config/teams_recipients.example.json; file *.local.json da gitignore. Kiem: python scripts/kiem_teams_dung_chung.py
# Watchdog gui toi WATCHDOG_TEAMS_RECIPIENT, bo trong = UPN cua audience C-Level. Quay lai 6 Flow: TEAMS_DELIVERY_MODE=legacy.
TEAMS_DELIVERY_MODE=legacy
TEAMS_SHARED_WEBHOOK_URL=
TEAMS_RECIPIENTS_FILE=config/teams_recipients.local.json
# WATCHDOG_TEAMS_RECIPIENT=

# CHATBOT_USERS_JSON: tài khoản đăng nhập web chatbot (backend/main.py) — JSON object
# {"username": "password"}. 28/09/2026: KHONG con dung - tai khoan nam trong backend/auth.db. Truoc day
# file mau nay chua san 2 tai khoan admin/c_level (repo public) - de trong. KHÔNG hardcode mật khẩu thật trong
# bất kỳ file nào của repo, chỉ đặt trong .env (đã gitignore, không commit).
CHATBOT_USERS_JSON=
