# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# backend (Python) - khong commit du lieu/DB/log, chi commit code
backend/__pycache__/
backend/*.db
backend/logs/
backend/*.txt

# Python cache o MOI thu muc (truoc day chi chan backend/, nen __pycache__ o root,
# ai_agent/, scripts/, src/, tests/ van hien trong git status)
__pycache__/
*.py[cod]

# Du lieu chay va file tam.
# LUU Y: .gitignore KHONG ho tro comment cung dong - dau # chi co tac dung o DAU dong.
# Viet "data/   # ghi chu" se thanh mau literal ke ca phan ghi chu, khong khop gi ca.
# data/     : alerts_state.db - trang thai canh bao, sinh ra khi chay (~6.7MB)
# scratch/  : bieu do va script nhap (~8.3MB)
data/
scratch/
nssm_log.txt

# Script sinh DU LIEU GIA - chi dung tren may dev, TUYET DOI khong dua len git.
# seed_mock_logs.py ghi thang vao audit_log.jsonl/cost_log.jsonl (co ca duong dan cung
# D:\DNH\backend\logs), seed_warehouse_data.py ghi doanh so gia vao warehouse.db.
# Neu len git roi ai chay tren may 24 se lam ban dung so lieu that.
backend/seed_mock_logs.py
backend/seed_warehouse_data.py

# Script khoi tao/dat lai mat khau tai khoan C-Level - chay TAY tren tung may.
backend/create_admin.py
