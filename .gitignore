# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# backend (Python) - khong commit du lieu/DB/log, chi commit code
backend/__pycache__/
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/logs/
backend/*.txt

# Database runtime do ETL/bao cao sinh ra. Cac file nay co the chua du lieu
# van hanh thuc te, tuyet doi khong dua vao Git. DB fixture trong mock_source/
# van duoc phep track de phuc vu test.
/scripts/*.db
/scripts/*.db-wal
/scripts/*.db-shm
/bao-cao-canh-bao/scripts/*.db
/bao-cao-canh-bao/scripts/*.db-wal
/bao-cao-canh-bao/scripts/*.db-shm

# Python cache o MOI thu muc (truoc day chi chan backend/, nen __pycache__ o root,
# ai_agent/, scripts/, src/, tests/ van hien trong git status)
__pycache__/
*.py[cod]

# Script khoi tao tai khoan admin - chay TAY tren tung may, khong commit.
# Ly do: script nay tao/dat lai mat khau tai khoan C-Level. Giu ngoai git de khong ai
# vo tinh chay trong quy trinh deploy va doi mat khau tai khoan dang dung de demo.
backend/create_admin.py

# 12/08/2026 - file rac/backup tam tich luy qua nhieu lan deploy tay (khong phai code that)
*.bak_*
_old_debug_scripts/
*.corrupted_*

# Binary cong cu cai dat local (cloudflared.exe, node.exe...) - qua lon cho git, moi may tu cai
tools/

# State runtime (DB/JSON tu sinh khi chay, khong phai code) - tuong tu backend/*.db o tren
data/
backend/health_watchdog_state.json

# Environment-specific SQL allowlist and sensitive-data classification supplied by DNH.
# Commit only the redacted example, never the production policy.
config/sql_catalog_policy.local.json

# 18/08/2026 - phat hien khi kiem lai viec ngay 17-19: 3 file/thu muc nay khong nam trong bat
# ky luat ignore nao o tren nen "git add -A" vo tinh se stage duoc. Ket qua cong cu (JSON/MD tu
# scripts/run_business_evaluation.py) la runtime output, khong phai code, cung mot trieu chung
# voi pattern data/ o tren.
/scratch/
.understand-anything/
/nssm_log.txt
/results/
/.tmp-codex-*/

# Báo cáo đối chiếu sinh từ dữ liệu vận hành thật; giữ local, không đưa dữ liệu
# nhân viên/khách hàng/doanh thu/công nợ vào Git.
/docs/bao_cao_sql_doi_chung_*.md
/docs/dap_an_bo_cau_hoi_dieu_hanh.md
/docs/dap_an_kiem_lai_*.md
/docs/doi_chieu_snapshot_vs_hoadon.md
/docs/doi_chieu_snapshot_vs_hoadon_bo_trung_lap.md
/docs/doi_chieu_bo_trung_lap.md
/docs/kiem_lai_*.md
/docs/bao_cao_S27_S30.md
/docs/dap_an_S27_S30.md

# Gói bàn giao UAT có kết quả chạy thật; chỉ lưu local và gửi qua kênh nội bộ.
/handoff_private/
/outputs/**/*.inspect.ndjson
