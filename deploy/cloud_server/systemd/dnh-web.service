# /etc/systemd/system/dnh-web.service - web chatbot DNH (Next.js `next start`) tren Cloud Server.
# Chi nghe 127.0.0.1:3000; Nginx dung truoc. Ban dang chay = /opt/dnh-web/current (symlink toi mot ban
# trong /opt/dnh-web/releases, do deploy_web.sh doi). Sua trong repo, cai lai bang cai_dat_lan_dau.sh.
[Unit]
Description=DNH chatbot web (Next.js) - 127.0.0.1:3000
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dnhweb
Group=dnhweb
WorkingDirectory=/opt/dnh-web/current
# BACKEND_API_URL (backend may 24 qua duong ham) + BACKEND_API_KEY. File 0640 root:dnhweb, khong nam trong repo.
EnvironmentFile=/etc/dnh-web/web.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
MemoryMax=1G

# Web chi can doc ma nguon cua ban dang chay va ghi .next/cache (thu muc nay thuoc dnhweb, con lai
# thuoc dnhdeploy nen tien trinh web khong sua duoc ma cua chinh no).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dnh-web/releases
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
